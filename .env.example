# setlist.fm API key — free at https://www.setlist.fm/settings/api
SETLISTFM_API_KEY=

# Apple Music (MusicKit) — from https://developer.apple.com/account
# Team ID: shown in Membership details
APPLE_TEAM_ID=
# Key ID of a key with the "Media Services (MusicKit)" capability
APPLE_KEY_ID=
# Contents of the downloaded AuthKey_XXXX.p8 file. Newlines may be written as \n.
APPLE_PRIVATE_KEY=

# Apple Music storefront used for catalog searches (two-letter country code)
APPLE_STOREFRONT=us
